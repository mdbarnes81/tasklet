{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "echo \"[tasklet] agent session started $(date -u +%Y-%m-%dT%H:%M:%SZ)\" >&2",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/scripts/guard-shell.mjs",
        "powershell": "node .github/hooks/scripts/guard-shell.mjs",
        "timeoutSec": 10
      }
    ]
  }
}
